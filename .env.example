# ==============================================================================
# BizBox Platform Environment Configuration (FlutterFlirt Private Limited)
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
# The BizBox database holds both the POS schema and the Store schema
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bizbox?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bizbox

# ------------------------------------------------------------------------------
# 2. Redis & Caching
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. Message Broker (NATS)
# ------------------------------------------------------------------------------
NATS_URL=nats://localhost:4222

# ------------------------------------------------------------------------------
# 4. Storage & Artifacts (MinIO / S3)
# ------------------------------------------------------------------------------
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_BUNDLES=bizbox-bundles
S3_BUCKET_ASSETS=bizbox-assets

# ------------------------------------------------------------------------------
# 5. OCI Container Registry
# ------------------------------------------------------------------------------
REGISTRY_HOST=registry.bizbox.in
REGISTRY_INTERNAL_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 6. Cryptographic Image & Bundle Signing (Cosign)
# ------------------------------------------------------------------------------
COSIGN_PUBKEY_PATH=./certs/cosign.pub
COSIGN_KEY_PATH=./certs/cosign.key
COSIGN_PASSWORD=bizbox-secret

# ------------------------------------------------------------------------------
# 7. Billing & Payments (Razorpay Subscriptions & UPI AutoPay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_samplekey
RAZORPAY_KEY_SECRET=sample_secret
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret

# ------------------------------------------------------------------------------
# 8. Authentication & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-bizbox-platform-jwt-token-key-2026
JWT_EXPIRES_IN=24h
DEVICE_AUTH_SECRET=device-secret-key-32-chars-minimum

# ------------------------------------------------------------------------------
# 9. ClickHouse (Usage Analytics)
# ------------------------------------------------------------------------------
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=bizbox_analytics

# ------------------------------------------------------------------------------
# 10. Frontends URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3001
NEXT_PUBLIC_DEV_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
